# Domi-fy Environment Configuration Example
# Placeholders only. Copy this file to .env and supply actual local values.
# .env is ignored by git. Never commit real secrets.

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# Local docker-compose default: postgresql://domify_user:domify_password@localhost:5432/domify_db
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://domify_user:domify_password@localhost:5432/domify_db"

# ------------------------------------------------------------------------------
# Object Storage (MinIO local dev / Cloudflare R2 production)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadminpassword"
STORAGE_BUCKET_NAME="domify-private-documents"
STORAGE_FORCE_PATH_STYLE="true"

# ------------------------------------------------------------------------------
# Payment Provider (Paystack Test Mode Only)
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_placeholder"
PAYSTACK_PUBLIC_KEY="pk_test_placeholder"

# ------------------------------------------------------------------------------
# Application Base URL
# ------------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
